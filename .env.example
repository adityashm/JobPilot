# ==============================================================================
# JobPilot - Environment Configuration Example
# ==============================================================================

# Backend API Configuration
ENVIRONMENT=development
PROJECT_NAME="JobPilot API"
VERSION=0.1.0
API_V1_STR=/api/v1

# Security & JWT Authentication
# Generate a secure secret in production: openssl rand -hex 32
SECRET_KEY=jobpilot_dev_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL)
# For local Docker: postgresql+psycopg2://jobpilot:jobpilot@localhost:5432/jobpilot
# For dev quickstart without Postgres: sqlite:///./jobpilot.db
DATABASE_URL=postgresql+psycopg2://jobpilot:jobpilot@localhost:5432/jobpilot

# Redis (Caching & Background Jobs)
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (comma separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Abstraction (Phase 4 & beyond)
# Supported values: 'ollama' | 'openrouter'
AI_PROVIDER=ollama
AI_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
OPENROUTER_API_KEY=

# Frontend Web App Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
